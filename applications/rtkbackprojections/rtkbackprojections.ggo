purpose "Backprojects a volume according to a geometry file."

option "geometry"  g  "XML geometry file name"                                   string   yes
option "output"    o "Output volume file name"                                   string   yes

section "Projectors"
option "bp"    - "Backprojection method" values="VoxelBasedBackProjection","FDKBackProjection","FDKWarpBackProjection","Joseph","JosephAttenuated", "Zeng", "CudaZeng", "CudaFDKBackProjection","CudaBackProjection","CudaRayCast"  enum no default="VoxelBasedBackProjection"
option "attenuationmap" - "Attenuation map relative to the volume to perform the attenuation correction"   string  no
option "sigmazero" - "PSF value at a distance of 0 meter of the detector"   double  no
option "alphapsf" - "Slope of the PSF against the detector distance"   double  no
option "sigmazeroy" - "PSF value at a distance of 0 meter of the detector along the second axis of the projections, if not the one of sigmazero (Zeng and CudaZeng only)"   double  no
option "alphapsfy" - "Slope of the PSF against the detector distance along the second axis of the projections, if not the one of alphapsf (Zeng and CudaZeng only)"   double  no

section "Warped backprojection"
option "signal"    - "Signal file name"          string    no
option "dvf"       - "Input 4D DVF"              string    no
