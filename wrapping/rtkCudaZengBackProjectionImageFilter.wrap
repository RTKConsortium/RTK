if(RTK_USE_CUDA)

  itk_wrap_class("itk::CudaImageToImageFilter" POINTER)

    itk_wrap_template("CI${ITKM_F}3CI${ITKM_F}3ZBPCI${ITKM_F}3CI${ITKM_F}3"
      "itk::CudaImage<${ITKT_F}, 3>, itk::CudaImage<${ITKT_F}, 3>, rtk::ZengBackProjectionImageFilter< itk::CudaImage<${ITKT_F}, 3>, itk::CudaImage<${ITKT_F}, 3> >")

  itk_end_wrap_class()

  itk_wrap_class("itk::CudaInPlaceImageFilter" POINTER)

    itk_wrap_template("CI${ITKM_F}3CI${ITKM_F}3ZBPCI${ITKM_F}3CI${ITKM_F}3"
      "itk::CudaImage<${ITKT_F}, 3>, itk::CudaImage<${ITKT_F}, 3>, rtk::ZengBackProjectionImageFilter< itk::CudaImage<${ITKT_F}, 3>, itk::CudaImage<${ITKT_F}, 3> >")

  itk_end_wrap_class()

  itk_wrap_simple_class("rtk::CudaZengBackProjectionImageFilter" POINTER)

endif()
