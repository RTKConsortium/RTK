itk_wrap_class("rtk::HilbertImageFilter" POINTER)
  # HilbertImageFilter maps a real 1D signal to a complex 1D analytic signal.
  # Do not use itk_wrap_image_filter: it assumes identical input/output types
  # and skips dimensions absent from ITK_WRAP_IMAGE_DIMS.
  foreach(t ${WRAP_ITK_REAL})
    set(ct "C${t}")
    list(FIND WRAP_ITK_COMPLEX_REAL "${ct}" _complex_index)
    if (NOT ${_complex_index} EQUAL -1)
      itk_wrap_template("I${ITKM_${t}}1I${ITKM_${ct}}1"
        "itk::Image<${ITKT_${t}}, 1>, itk::Image<${ITKT_${ct}}, 1>")
    endif()
  endforeach()
itk_end_wrap_class()
