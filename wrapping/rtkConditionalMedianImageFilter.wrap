itk_wrap_class("rtk::ConditionalMedianImageFilter" POINTER)
  itk_wrap_image_filter("${WRAP_ITK_REAL}" 1)
  itk_wrap_template("VI${ITKM_F}3" "itk::VectorImage<${ITKT_F}, 3>")
  set(vectorComponents 2 3 4 5)
  foreach(vc ${vectorComponents})
    foreach(vt ${WRAP_ITK_VECTOR_REAL})
      itk_wrap_template("I${ITKM_${vt}${vc}}3" "itk::Image<${ITKT_${vt}${vc}},3>")
    endforeach()
  endforeach()
itk_end_wrap_class()
